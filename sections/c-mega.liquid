{{ 'c-mega.css' | asset_url | stylesheet_tag }}
<header class="mega-menu">
  <nav class="mega-nav">

    {% for block in section.blocks %}
      <div class="mega-item" {{ block.shopify_attributes }}>

        <a href="{{ block.settings.main_link }}" class="mega-link">
          {{ block.settings.title }}
        </a>

        {% unless block.type == 'simple_link' %}
          <div class="mega-dropdown">
            {% case block.type %}

              {% when 'links_products' %}
                {% render 'mega-links-products', block: block %}

              {% when 'bundle_banner' %}
                {% render 'mega-bundle-banner', block: block %}

            {% endcase %}
          </div>
        {% endunless %}

      </div>
    {% endfor %}

  </nav>
</header>

<script>
    document.querySelectorAll('.mega-link').forEach(link=>{
  link.addEventListener('click',e=>{
    if(window.innerWidth < 990){
      e.preventDefault()
      link.nextElementSibling.classList.add('open')
    }
  })
})

document.querySelectorAll('.back-btn').forEach(btn=>{
  btn.onclick = ()=>{
    btn.closest('.mega-dropdown').classList.remove('open')
  }
})
</script>