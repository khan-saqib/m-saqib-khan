{{ 'c-mega.css' | asset_url | stylesheet_tag }}
<header class="mega-menu">
  <nav class="mega-nav">

    {% for block in section.blocks %}
      <div class="mega-item" {{ block.shopify_attributes }}>

        <a href="{{ block.settings.main_link }}" class="mega-link">
          {{ block.settings.title }}
        </a>

        {% unless block.type == 'simple_link' %}
          <div class="mega-dropdown">
            {% case block.type %}

              {% when 'links_products' %}
                {% render 'mega-links-products', block: block %}

              {% when 'bundle_banner' %}
                {% render 'mega-bundle-banner', block: block %}

            {% endcase %}
          </div>
        {% endunless %}

      </div>
    {% endfor %}

  </nav>
</header>

<script>
    document.querySelectorAll('.mega-link').forEach(link=>{
  link.addEventListener('click',e=>{
    if(window.innerWidth < 990){
      e.preventDefault()
      link.nextElementSibling.classList.add('open')
    }
  })
})

document.querySelectorAll('.back-btn').forEach(btn=>{
  btn.onclick = ()=>{
    btn.closest('.mega-dropdown').classList.remove('open')
  }
})
</script>

{% schema %}
{
  "name": "Mega Menu",
  "blocks":[

    {
      "type":"links_products",
      "name":"Links + Products",
      "settings":[
        { "type":"text","id":"title","label":"Menu Title"},
        { "type":"url","id":"main_link","label":"Main Link"},
        { "type":"collection","id":"collection","label":"Collection"},

        { "type":"text","id":"heading_1","label":"Heading 1"},
        { "type":"link_list","id":"menu_1","label":"Menu 1"},

        { "type":"text","id":"heading_2","label":"Heading 2"},
        { "type":"link_list","id":"menu_2","label":"Menu 2"},

        { "type":"text","id":"heading_3","label":"Heading 3"},
        { "type":"link_list","id":"menu_3","label":"Menu 3"},

        { "type":"text","id":"heading_4","label":"Heading 4"},
        { "type":"link_list","id":"menu_4","label":"Menu 4"},

        { "type":"text","id":"heading_5","label":"Heading 5"},
        { "type":"link_list","id":"menu_5","label":"Menu 5"}
      ]
    },

    {
      "type":"bundle_banner",
      "name":"Bundle Banner",
      "settings":[
        { "type":"text","id":"title","label":"Menu Title"},
        { "type":"url","id":"main_link","label":"Main Link"},
        { "type":"image_picker","id":"image","label":"Image"},
        { "type":"text","id":"btn1_text","label":"Button 1"},
        { "type":"url","id":"btn1_link","label":"Button 1 Link"},
        { "type":"text","id":"btn2_text","label":"Button 2"},
        { "type":"url","id":"btn2_link","label":"Button 2 Link"}
      ]
    },

    {
      "type":"simple_link",
      "name":"Simple Link",
      "settings":[
        { "type":"text","id":"title","label":"Title"},
        { "type":"url","id":"main_link","label":"Link"}
      ]
    }

  ]
}
{% endschema %}