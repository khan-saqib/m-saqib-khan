<style>
    .mega-bundle{
display:flex;
gap:60px;
align-items:center;
}

.mega-bundle__steps{
flex:1;
}

.mega-bundle__steps h3{
font-size:20px;
margin-bottom:20px;
}

.bundle-progress{
display:flex;
align-items:center;
gap:25px;
}

.bundle-step{
text-align:center;
max-width:120px;
}

.bundle-step span{
display:inline-block;
background:#e8a1b2;
color:white;
padding:6px 10px;
border-radius:6px;
font-size:12px;
margin-bottom:6px;
}

.bundle-step.unlocked span{
background:#6f8795;
}

.bundle-step p{
font-weight:600;
font-size:13px;
}

.bundle-step small{
font-size:12px;
color:#777;
}


/* IMAGE */

.mega-bundle__image{
flex:1;
position:relative;
}

.mega-bundle__image img{
border-radius:10px;
}


/* CTA */

.bundle-cta{
position:absolute;
bottom:20px;
left:20px;
display:flex;
gap:10px;
}

.bundle-btn{
padding:10px 18px;
border-radius:8px;
font-size:14px;
text-decoration:none;
}

.bundle-btn.primary{
background:#e8a1b2;
color:white;
}

.bundle-btn.secondary{
background:#6f8795;
color:white;
}
</style>
<div class="mega-bundle">

  <div class="mega-bundle__steps">

    <h3>HOW YOU SAVE</h3>

    <div class="bundle-progress">

      <div class="bundle-step unlocked">
        <span>10% OFF</span>
        <p>BUY 2</p>
        <small>Unlocked!</small>
      </div>

      <div class="bundle-step">
        <span>15% OFF</span>
        <p>BUY 3</p>
        <small>1 More To Unlock</small>
      </div>

      <div class="bundle-step">
        <span>20% OFF</span>
        <p>BUY 4</p>
        <small>2 More To Unlock</small>
      </div>

      <div class="bundle-step">
        <span>FREE SHIPPING</span>
        <p>SPEND OVER $50</p>
      </div>

    </div>

  </div>

  <div class="mega-bundle__image">

    {{ block.settings.image | image_url: width: 900 | image_tag }}

    <div class="bundle-cta">

      <a href="{{ block.settings.btn1_link }}" class="bundle-btn primary">
        {{ block.settings.btn1_text }}
      </a>

      <a href="{{ block.settings.btn2_link }}" class="bundle-btn secondary">
        {{ block.settings.btn2_text }}
      </a>

    </div>

  </div>

</div>